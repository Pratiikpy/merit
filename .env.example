# ============================================================================
# Merit — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local — it is git-ignored and holds real keys.
# ============================================================================

# --- Mode ---
# STUB=1 runs fully offline (no keys or funds). STUB=0 settles real USDC on Arc.
STUB=0
# Write ERC-8004 reputation on-chain (1) or keep merit cache-only (0).
REPUTATION_ONCHAIN=1

# --- Arc / Circle Nanopayments (x402 + Gateway) ---
# Run `npm run generate-wallets` to create the EOAs, then fund the buyer
# (and the operator, if REPUTATION_ONCHAIN=1) at https://faucet.circle.com
SELLER_ADDRESS=0xYourSellerAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey
BUYER_ADDRESS=0xYourBuyerAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey
OPERATOR_ADDRESS=0xYourOperatorAddress
OPERATOR_PRIVATE_KEY=0xYourOperatorPrivateKey
ARC_RPC_URL=https://rpc.testnet.arc.network

# --- LLM (provider-agnostic: NVIDIA, OpenAI, or any OpenAI-compatible API) ---
# Auto-detected from the key prefix: nvapi- → NVIDIA, sk- → OpenAI.
# Without a usable key, the agent uses a templated answer + lexical citation check.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k2.6
EMBED_MODEL=nvidia/nv-embedqa-e5-v5
EMBED_INPUT_TYPE=query

# --- Optional: durable receipts mirror (the app runs fine without it) ---
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Which Arc? (default: testnet — the network every verified transaction in this repo used) ---
# Arc mainnet launched (chain 5042, live 2026-09) and Circle's Gateway SDK ships an "arc" chain key
# alongside arcTestnet as of @circle-fin/x402-batching 3.x. Every value below except the ERC-8004
# registries was read live off Arc mainnet (eth_chainId / eth_getCode) on 2026-09-23 — never guessed.
# Merit still treats the network as configuration and never substitutes a testnet address for a missing
# mainnet one — GET /api/health reports exactly what is still required. Moving this deployment to Arc
# mainnet is these variables plus the 7 Merit contracts redeployed there (they do not exist on mainnet
# yet — testnet and mainnet are separate chains), not a code change.
# ARC_NETWORK=mainnet
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_EXPLORER=https://explorer.arc.io
ARC_MAINNET_USDC=0x3600000000000000000000000000000000000000
ARC_MAINNET_GATEWAY_WALLET=0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE
# ERC-8004 identity/reputation/validation registries have NO published Arc mainnet address (checked the
# live Arc docs and eth_getCode at the testnet address on mainnet: not deployed there). Leave unset until
# Circle/the ERC-8004 deployer ships them — Merit degrades honestly (ERC-8004 writes skip) rather than
# guessing an address.
# ARC_MAINNET_IDENTITY_REGISTRY=
# ARC_MAINNET_REPUTATION_REGISTRY=
# ARC_MAINNET_VALIDATION_REGISTRY=
# Arc's Memo / Multicall3From transaction extensions are predeployed at the SAME address on mainnet as
# testnet (confirmed via eth_getCode on both chains).
ARC_MAINNET_MEMO=0x5294E9927c3306DcBaDb03fe70b92e01cCede505
ARC_MAINNET_MULTICALL3FROM=0x522fAf9A91c41c443c66765030741e4AaCe147D0
ARC_MAINNET_GATEWAY_CHAIN=arc               # Gateway domain 26 — the mainnet key, added in x402-batching 3.x
# --- Arc mainnet contract deployment (fill in AFTER `forge script DeployAll --rpc-url arc_mainnet
# --broadcast`, funded from a wallet holding REAL USDC — see contracts/DEPLOY-MAINNET.md) ---
# MERITJOB_ADDRESS=
# MERIT_HOOK_ADDRESS=
# ESCROW_ADDRESS=
# STAKE_ADDRESS=
# INSURANCE_ADDRESS=
# MARKET_ADDRESS=
# ATTEST_ADDRESS=

# --- Arc-native settlement (both optional; sane defaults) ---
# Every payout is wrapped in Arc's predeployed Memo contract so the verdict travels INSIDE the payment.
# On by default on a live deploy; set to 0 to send plain ERC-20 transfers instead (~22k gas cheaper,
# and no on-chain proof of what the money settled).
# ARC_MEMO=1
# The EOA whose USDC pays the gas for gasless (EIP-3009) funding via POST /api/relay. Falls back to
# BUYER_PRIVATE_KEY when unset. Its balance IS its gas supply — keep it funded.
# RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKey
# The smallest transfer worth relaying. Merit pays ~0.0023 USDC of gas per relay, so without a floor an
# attacker with a free API key can drain the relayer one dust transfer at a time. Default 0.01 USDC.
# MERIT_RELAY_MIN_USDC=0.01
# Relay to ANY destination rather than only the caller's own deposit address. Off by default: an open relay
# is a gas faucet for strangers. Only enable if you intend to subsidise third-party transfers.
# MERIT_RELAY_OPEN=1

# --- Optional ---
# (The lead's x402 self-calls are a fixed loopback to localhost:$PORT — no BASE_URL needed.)
# MERIT_DATA_DIR=    # registry location; defaults to ./.data (point at a mounted disk to persist across redeploys)
